# Origin used for metadata (Open Graph, canonical links).
# In production set this to the deployed Flux web origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the Flux backend API (no trailing slash, no /api suffix).
# Required in production. In development it falls back to http://localhost:3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ─── Flux web — environment variables ────────────────────────────────────────
#
# For Vercel: add these in Project → Settings → Environment Variables
# (Production + Preview). Because they are NEXT_PUBLIC_* vars they are baked
# into the client bundle at BUILD time — set them BEFORE deploying, and
# redeploy after any change.

# REQUIRED in production. Origin of the Flux backend API.
# The /verify and /reset-password pages intentionally show a config error
# message instead of silently guessing when this is missing on a build
# marked production (see lib/auth-api.ts getApiBaseUrl()).
#
#   - No trailing slash
#   - No /api suffix (routes are appended as /auth/...)
#   - Example: https://api.your-flux-host.com
#
# Development only (no var needed): falls back to http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=https://api.example-flux-host.com

# RECOMMENDED. Public origin of this website, used for canonical and
# Open Graph metadata only. If unset it falls back to http://localhost:3000,
# which would put localhost URLs into production metadata.
#
#   - No trailing slash
#   - Example: https://your-flux-site.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-flux-site.vercel.app
